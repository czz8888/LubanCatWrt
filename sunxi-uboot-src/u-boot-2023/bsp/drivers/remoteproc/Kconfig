config AW_REMOTEPROC
	bool "SUNXI remoteproc driver"
	depends on DM
	select REMOTEPROC
	default n
	help
	  Support for SUNXI remoteproc.

if AW_REMOTEPROC

config AW_RPROC_MISC_OPS
	depends on AW_REMOTEPROC
	bool "Sunxi remoteproc misc ops support"

config AW_RPROC_RSC_HELPER
	depends on AW_REMOTEPROC
	bool "Sunxi remoteproc rsc helper support"

config AW_RPROC_USER_RESOURCE
	select AW_RPROC_MISC_OPS
	depends on AW_RPROC_RSC_HELPER
	bool "Sunxi remoteproc user resource handle support"

config AW_RPROC_BOOT_REASON
	depends on AW_REMOTEPROC
	bool "Sunxi remoteproc boot reason support"

config BOOT_RISCV
	bool "Support RISCV"
	default n

config RISCV_UPDATA_IRQ_TAB
	bool "Support RISCV share irq table updata"
	depends on BOOT_RISCV
	default n

config RISCV_UPDATA_IRQ_TAB_DEBUG
	bool "Support RISCV share irq table updata debug log"
	depends on RISCV_UPDATA_IRQ_TAB
	default n

config AW_VF_FOR_T536
	bool "Select vf table for t536 plarform"
	default n
endif
